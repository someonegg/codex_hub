{
  "name": "@someonegg/agent-hub",
  "version": "0.7.0",
  "description": "Local project and session hub for coding agents",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/main.js",
    "benchmark:scale": "tsx scripts/benchmark-scale.ts",
    "test": "vitest run",
    "test:integration:codex": "vitest run --config vitest.integration.config.ts tests/integration/codex-management.integration.ts",
    "test:all": "npm test && npm run test:integration:tmux && npm run test:integration:codex && npm run test:integration:claude",
    "test:integration:tmux": "vitest run --config vitest.integration.config.ts tests/integration/tmux-service.integration.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests-server.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "lint-client",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs",
    "test:hosting": "npm run build && node --import tsx scripts/test-hosting.mjs",
    "test:integration:claude": "vitest run --config vitest.integration.config.ts tests/integration/claude-management.integration.ts"
  },
  "keywords": [
    "agent",
    "codex",
    "claude",
    "sessions",
    "reader"
  ],
  "license": "MIT",
  "dependencies": {
    "@types/estree": "1.0.9",
    "i18next": "^26.5.11",
    "katex": "^0.18.10",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.1.9",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "string-width": "^8.3.0",
    "ws": "^8.22.0"
  },
  "overrides": {
    "katex": "$katex",
    "@ahub/client-lint": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@babel/parser": "^7.29.12",
    "@ahub/client-lint": "file:tools/client-lint",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.1.3",
    "prettier": "3.6.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "bin": {
    "agent-hub": "dist/server/server/main.js",
    "ahub-cli": "dist/server/server/cli/main.js"
  },
  "files": [
    "skills/ahub-publish",
    "skills/ahub-control",
    "dist/client",
    "dist/server",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/someonegg/agent_hub.git"
  },
  "homepage": "https://github.com/someonegg/agent_hub#readme",
  "bugs": {
    "url": "https://github.com/someonegg/agent_hub/issues"
  }
}
